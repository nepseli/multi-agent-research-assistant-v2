# --- Required ---
OPENROUTER_API_KEY=your_openrouter_api_key
SERPER_API_KEY=your_serper_api_key

# --- Models per role (provider/model, as LiteLLM expects) ---
ROUTER_AGENT_LLM=openrouter/openai/gpt-oss-20b
ROUTER_AGENT_TEMP=0.0
RESEARCH_AGENT_LLM=openrouter/openai/gpt-oss-20b
RESEARCH_AGENT_TEMP=0.3
ANALYST_AGENT_LLM=openrouter/openai/gpt-oss-20b
ANALYST_AGENT_TEMP=0.3
WRITER_AGENT_LLM=openrouter/openai/gpt-oss-20b
WRITER_AGENT_TEMP=0.3
FIGURE_PLANNER_LLM=openrouter/openai/gpt-oss-20b
FIGURE_PLANNER_TEMP=0.0

# --- Optional stronger models used only when "Professional PDF report" is ticked ---
# Check the exact GPT-5 model ID in OpenRouter's model list before enabling; it was not verified.
# WRITER_AGENT_LLM_PDF=openrouter/openai/gpt-5
# WRITER_AGENT_TEMP_PDF=0.3
# FIGURE_PLANNER_LLM_PDF=openrouter/openai/gpt-5
# FIGURE_PLANNER_TEMP_PDF=0.0

# --- Optional search helpers ---
OPENALEX_EMAIL=
UNPAYWALL_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
FIRECRAWL_API_KEY=

# --- Docker worker (Crawl4AI, Docling, PDF rendering) ---
WORKER_URL=http://localhost:8000
