# --- Required ---
OPENROUTER_API_KEY=your_openrouter_api_key
SERPER_API_KEY=your_serper_api_key

# --- Models (provider/model, as LiteLLM expects) ---
# Two tiers. Each step uses its tier's model unless you set a per-role override below.
#   Strong: router (triage), research agent, analyst, writer (report sections)
#   Light:  editor (outline, length adjustment, citation repair), figure and diagram planner
STRONG_LLM=openrouter/openai/gpt-oss-120b
LIGHT_LLM=openrouter/openai/gpt-oss-20b

# Optional per-role overrides. A role's own setting beats its tier's.
# Roles: ROUTER_AGENT, RESEARCH_AGENT, ANALYST_AGENT, WRITER_AGENT, EDITOR, FIGURE_PLANNER
# ANALYST_AGENT_LLM=openrouter/anthropic/claude-sonnet-5.5
# Temperatures default to 0.0 (router, figure planner), 0.2 (editor) and 0.3 (the rest).
# RESEARCH_AGENT_TEMP=0.3

# --- Optional models used only when "Professional PDF report" is ticked ---
# Lookup order in PDF mode: ROLE_LLM_PDF, then STRONG_LLM_PDF / LIGHT_LLM_PDF, then the settings above.
# STRONG_LLM_PDF=openrouter/openai/gpt-5
# WRITER_AGENT_LLM_PDF=openrouter/openai/gpt-5
# WRITER_AGENT_TEMP_PDF=0.3

# --- Optional search helpers ---
OPENALEX_EMAIL=
UNPAYWALL_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
FIRECRAWL_API_KEY=

# --- Docker worker (Crawl4AI, Docling, PDF rendering) ---
WORKER_URL=http://localhost:8000
