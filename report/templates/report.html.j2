<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"><title>{{ title }}</title>
<style>
@page { size: A4; margin: 22mm 18mm; }  /* page numbers come from the renderer's "N / M" footer */
body { font-family: "Georgia", serif; font-size: 10.5pt; line-height: 1.5; color: #222; }
h1 { font-size: 22pt; color: #1f4e79; border-bottom: 2px solid #1f4e79; padding-bottom: 6px; }
h2 { font-size: 14pt; color: #1f4e79; margin-top: 18pt; }
table { border-collapse: collapse; width: 100%; margin: 10pt 0; font-size: 9.5pt; }
th, td { border: 1px solid #bbb; padding: 4px 6px; text-align: left; }
th { background: #eaf0f6; }
caption, figcaption { font-size: 9pt; color: #555; margin: 4pt 0 10pt; }
figure { margin: 12pt 0; text-align: center; page-break-inside: avoid; }
figure img { max-width: 100%; }
/* A diagram must fit on one page with its caption; the planner already rejects drawings far over this. */
figure.diagram pre.mermaid { margin: 0; }
figure.diagram svg { max-width: 100% !important; max-height: 160mm; height: auto; }
#figures-heading { break-after: avoid; page-break-after: avoid; }
/* The "How this report was made" box under the title. */
blockquote { margin: 6pt 0 14pt; padding: 8pt 12pt; background: #f4f7fb; border-left: 3px solid #1f4e79;
             font-size: 9.5pt; color: #333; }
blockquote p { margin: 0; }
a.cite { color: #1f4e79; text-decoration: none; }
.notes { font-size: 9pt; color: #555; border-top: 1px solid #ccc; margin-top: 18pt; }
</style></head>
<body>
{{ body | safe }}
{% if figures_html %}<section id="figures-section"><h2 id="figures-heading">Figures</h2>{{ figures_html | safe }}</section>{% endif %}
{{ references | safe }}
{% if notes %}<div class="notes"><h2>Coverage notes</h2><ul>{% for n in notes %}<li>{{ n }}</li>{% endfor %}</ul></div>{% endif %}
</body></html>
